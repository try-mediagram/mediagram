{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "localhost",
  "description": "The same permissions for the release build, which is served from http://localhost (see PORT in src/lib.rs).",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:14327/*"
    ]
  },
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close"
  ]
}
